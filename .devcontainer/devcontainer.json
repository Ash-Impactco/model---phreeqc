{
  "name": "Ilha Carbon ERW PHREEQC",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt && python scripts/get_modflow.py",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "ERW model app",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "streamlit run app.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}